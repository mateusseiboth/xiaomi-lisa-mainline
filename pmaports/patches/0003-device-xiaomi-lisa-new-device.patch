+# Reference: <https://nura.eco/deviceinfo>
+# Please use double quotes only. You can source this file in shell
+# scripts.
+
+deviceinfo_format_version="0"
+deviceinfo_name="Xiaomi 11 Lite 5G NE / 11 LE"
+deviceinfo_manufacturer="Xiaomi"
+deviceinfo_codename="xiaomi-lisa"
+deviceinfo_year="2021"
+deviceinfo_dtb="qcom/sm7325-xiaomi-lisa"
+deviceinfo_append_dtb="true"
+deviceinfo_arch="aarch64"
+deviceinfo_flash_kernel_on_update="true"
+
+# Device related
+deviceinfo_drm="true"
+deviceinfo_chassis="handset"
+deviceinfo_screen_width="1080"
+deviceinfo_screen_height="2400"
+
+# Bootloader related
+deviceinfo_flash_method="fastboot"
+deviceinfo_generate_bootimg="true"
+deviceinfo_flash_pagesize="4096"
+# Same load addresses as the stock vendor_boot, the ABL rejects the defaults.
+# boot-deploy does not pass the flash offsets to mkbootimg for header v3.
+deviceinfo_bootimg_custom_args="--base 0x00000000 --kernel_offset 0x00008000 --ramdisk_offset 0x01000000 --tags_offset 0x00000100 --dtb_offset 0x01f00000"
+deviceinfo_header_version="3"
+deviceinfo_rootfs_image_sector_size="4096"
+deviceinfo_super_partitions="/dev/sda20 /dev/sda20"
+deviceinfo_flash_fastboot_partition_vbmeta="vbmeta"
+deviceinfo_flash_fastboot_partition_dtbo="dtbo"
diff --git a/device/testing/device-xiaomi-lisa/dtbo-overlay.dts b/device/testing/device-xiaomi-lisa/dtbo-overlay.dts
new file mode 100644
index 0000000000..e095a800cf
--- /dev/null
+++ b/device/testing/device-xiaomi-lisa/dtbo-overlay.dts
@@ -0,0 +1,17 @@
+/dts-v1/;
+/plugin/;
+
+/*
+ * No-op overlay in the same form as the stock Xiaomi ones: target by label,
+ * resolved through __fixups__ against the main DTB __symbols__.
+ */
+/ {
+	model = "Xiaomi 11 Lite 5G NE";
+	compatible = "xiaomi,lisa", "qcom,sm7325";
+	qcom,msm-id = <0x1db 0x10000>;
+	qcom,board-id = <0x1000b 0x0>;
+};
+
+&framebuffer_mem {
+	xiaomi,mainline-dtbo-noop;
+};
diff --git a/device/testing/device-xiaomi-lisa/initfs-hook-panel-cycle.sh b/device/testing/device-xiaomi-lisa/initfs-hook-panel-cycle.sh
new file mode 100644
index 0000000000..a8195a1b2a
--- /dev/null
+++ b/device/testing/device-xiaomi-lisa/initfs-hook-panel-cycle.sh
@@ -0,0 +1,18 @@
+#!/bin/sh
+# The first DSI link bring-up after the bootloader hand-off is broken on lisa:
+# the panel stays dark and ignores DCS commands until the link is powered off
+# and on again. Do that once, as soon as the msm framebuffer shows up, so the
+# boot console is visible and the compositor's first modeset works.
+
+fb=/sys/class/graphics/fb0
+
+for _ in $(seq 1 100); do
+	[ "$(cat "$fb/name" 2>/dev/null)" = "msmdrmfb" ] && break
+	sleep 0.1
+done
+
+[ "$(cat "$fb/name" 2>/dev/null)" = "msmdrmfb" ] || exit 0
+
+echo 1 > "$fb/blank"
+sleep 0.2
+echo 0 > "$fb/blank"
