+deviceinfo_rootfs_image_sector_size="4096"
+deviceinfo_super_partitions="/dev/sda20 /dev/sda20"
+deviceinfo_flash_fastboot_partition_vbmeta="vbmeta"
+deviceinfo_flash_fastboot_partition_dtbo="dtbo"
