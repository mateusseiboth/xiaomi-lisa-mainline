++MODULE_DESCRIPTION("Panel driver for the CSOT VTDR6130 AMOLED DSI panel");
++MODULE_LICENSE("GPL");
diff --git a/device/community/linux-postmarketos-qcom-sc7280/0004-arm64-dts-qcom-sm7325-xiaomi-lisa-enable-display.patch b/device/community/linux-postmarketos-qcom-sc7280/0004-arm64-dts-qcom-sm7325-xiaomi-lisa-enable-display.patch
