++static int s5k5e9_write(struct s5k5e9 *s5k5e9, u16 reg, u16 len, u32 val)
++{
++	struct i2c_client *client = v4l2_get_subdevdata(&s5k5e9->sd);
++	u8 buf[6];
++
++	if (len > 4)
++		return -EINVAL;
++
