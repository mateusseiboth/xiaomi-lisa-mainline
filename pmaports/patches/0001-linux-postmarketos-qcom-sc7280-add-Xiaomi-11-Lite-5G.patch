++	put_unaligned_be32(val << 8 * (4 - len), buf + 2);
++	if (i2c_master_send(client, buf, len + 2) != len + 2) {
++		dev_err(&client->dev,
++			"Cannot write register %u!\n", reg);
++		return -EIO;
++	}
++
++	return 0;
++}
