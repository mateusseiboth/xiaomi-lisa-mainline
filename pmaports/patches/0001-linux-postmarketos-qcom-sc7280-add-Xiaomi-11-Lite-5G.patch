index 0000000..3354b30
--- /dev/null
+++ b/device/community/linux-postmarketos-qcom-sc7280/0004-arm64-dts-qcom-sm7325-xiaomi-lisa-enable-display.patch
@@ -0,0 +1,92 @@
+From: Mateus Seiboth <mateusseiboth12@gmail.com>
+Subject: [PATCH] arm64: dts: qcom: sm7325-xiaomi-lisa: enable the display
+
+CSOT VTDR6130 AMOLED on DSI0, panel, supplies and pins taken from the
+mainlining fork (adrian/lisa).
+---
+--- a/arch/arm64/boot/dts/qcom/sm7325-xiaomi-lisa.dts
++++ b/arch/arm64/boot/dts/qcom/sm7325-xiaomi-lisa.dts
+@@ -1150,3 +1150,83 @@
+ 	wdog: watchdog@17c10000 {
+ 	};
+ };
++
++/* Display: CSOT VTDR6130 AMOLED on DSI0, values from the mainlining fork */
++/ {
++	vreg_oled_dvdd: regulator-oled-dvdd {
++		compatible = "regulator-fixed";
++		regulator-name = "oled_dvdd";
++		regulator-min-microvolt = <1200000>;
++		regulator-max-microvolt = <1200000>;
++
++		gpio = <&tlmm 46 GPIO_ACTIVE_HIGH>;
++		enable-active-high;
++
++		vin-supply = <&vreg_s1b_1p856>;
++
++		regulator-boot-on;
++	};
++};
++
++&mdss {
++	status = "okay";
++};
++
++&mdss_dsi {
++	vdda-supply = <&vdd_a_dsi_0_1p2>;
++	status = "okay";
++
++	panel@0 {
++		compatible = "csot,vtdr6130";
++		reg = <0>;
++
++		reset-gpios = <&tlmm 44 GPIO_ACTIVE_LOW>;
++
++		vdd-supply = <&vreg_l13c_3p0>;
++		vddio-supply = <&vreg_l12c_1p8>;
++		dvdd-supply = <&vreg_oled_dvdd>;
++
++		pinctrl-0 = <&sde_dsi_active &sde_te_active_sleep>;
++		pinctrl-1 = <&sde_dsi_sleep &sde_te_active_sleep>;
++		pinctrl-names = "default", "sleep";
++
++		port {
++			panel_in: endpoint {
++				remote-endpoint = <&mdss_dsi0_out>;
++			};
++		};
++	};
++};
++
++&mdss_dsi0_out {
++	data-lanes = <0 1 2 3>;
++	remote-endpoint = <&panel_in>;
++};
++
++&mdss_dsi_phy {
++	vdds-supply = <&vdd_a_dsi_0_0p9>;
++	status = "okay";
++};
++
++&tlmm {
++	sde_dsi_active: sde-dsi-active-state {
++		pins = "gpio44";
++		function = "gpio";
++		drive-strength = <8>;
++		bias-disable;
++	};
++
++	sde_dsi_sleep: sde-dsi-sleep-state {
++		pins = "gpio44";
++		function = "gpio";
++		drive-strength = <2>;
++		bias-pull-down;
++	};
++
++	sde_te_active_sleep: sde-te-active-state {
++		pins = "gpio80";
++		function = "mdp_vsync";
++		drive-strength = <2>;
++		bias-pull-down;
++	};
++};
diff --git a/device/community/linux-postmarketos-qcom-sc7280/0005-arm64-dts-qcom-sm7325-xiaomi-lisa-enable-speaker-and-earpiece.patch b/device/community/linux-postmarketos-qcom-sc7280/0005-arm64-dts-qcom-sm7325-xiaomi-lisa-enable-speaker-and-earpiece.patch
new file mode 100644
index 0000000..c5cff34
--- /dev/null
+++ b/device/community/linux-postmarketos-qcom-sc7280/0005-arm64-dts-qcom-sm7325-xiaomi-lisa-enable-speaker-and-earpiece.patch
@@ -0,0 +1,150 @@
+From: Mateus Seiboth <mateusseiboth12@gmail.com>
+Subject: [PATCH] arm64: dts: qcom: sm7325-xiaomi-lisa: enable speaker and earpiece
+
+Two TFA9873 amplifiers on PRIMARY_MI2S with the q6asm/q6afe (APR) stack,
+like the Nothing Phone (1). I2C bus and reset GPIOs from the mainlining fork.
+---
+--- a/arch/arm64/boot/dts/qcom/sm7325-xiaomi-lisa.dts
++++ b/arch/arm64/boot/dts/qcom/sm7325-xiaomi-lisa.dts
+@@ -13,6 +13,8 @@
+ #include <dt-bindings/leds/common.h>
+ #include <dt-bindings/pinctrl/qcom,pmic-gpio.h>
+ #include <dt-bindings/regulator/qcom,rpmh-regulator.h>
++#include <dt-bindings/sound/qcom,q6afe.h>
++#include <dt-bindings/sound/qcom,q6asm.h>
+ 
+ #include "sm7325.dtsi"
+ #include "pm7325.dtsi"
+@@ -1230,3 +1232,132 @@
+ 		bias-pull-down;
+ 	};
+ };
++
++/*
++ * Speaker and earpiece: two TFA9873 amplifiers on PRIMARY_MI2S, same design
++ * as the Nothing Phone (1). Bus and reset GPIOs from the mainlining fork.
++ * Each amplifier needs its own name prefix (the codec widgets clash otherwise)
++ * and takes one I2S channel: left for the earpiece, right for the speaker.
++ */
++&i2c3 {
++	clock-frequency = <100000>;
++	status = "okay";
++
++	tfa9873_l: codec@34 { /* Earpiece */
++		compatible = "nxp,tfa9873",
++			     "nxp,tfa9872";
++		reg = <0x34>;
++		reset-gpio = <&tlmm 2 GPIO_ACTIVE_HIGH>;
++		sound-name-prefix = "Earpiece";
++		sound-channel = <0>;
++
++		#sound-dai-cells = <1>;
++	};
++
++	tfa9873_r: codec@35 { /* Speaker */
++		compatible = "nxp,tfa9873",
++			     "nxp,tfa9872";
++		reg = <0x35>;
++		reset-gpio = <&tlmm 6 GPIO_ACTIVE_HIGH>;
++		sound-name-prefix = "Speaker";
++		sound-channel = <1>;
++
++		#sound-dai-cells = <1>;
++	};
++};
++
++&lpass_audiocc {
++	compatible = "qcom,qcm6490-lpassaudiocc";
++	/delete-property/ power-domains;
++};
++
++&q6afedai {
++	dai@16 {
++		reg = <PRIMARY_MI2S_RX>;
++		qcom,sd-lines = <1>;
++	};
++};
++
++&q6asmdai {
++	dai@0 {
++		reg = <MSM_FRONTEND_DAI_MULTIMEDIA1>;
++	};
++};
++
++&sound {
++	compatible = "qcom,sm7325-sndcard",
++		     "qcom,sm8250-sndcard";
++
++	model = "Xiaomi 11 Lite 5G NE";
++
++	pinctrl-0 = <&pri_mi2s_bck_active &pri_mi2s_din_active
++		     &pri_mi2s_dout_active &pri_mi2s_ws_active>;
