# Reference: <https://nura.eco/devicepkg>
maintainer="Mateus Seiboth <mateusseiboth@gmail.com>"
pkgname=device-xiaomi-lisa
pkgdesc="Xiaomi 11 Lite 5G NE / 11 LE"
pkgver=1
pkgrel=0
url="https://postmarketos.org"
license="MIT"
arch="aarch64"
options="!check !archcheck"
depends="
	alsa-ucm-conf-qcom-sc7280
	android-tools
	firmware-qcom-adreno-a660
	firmware-xiaomi-lisa-adsp
	firmware-xiaomi-lisa-cdsp
	firmware-xiaomi-lisa-gpu
	firmware-xiaomi-lisa-ipa
	firmware-xiaomi-lisa-modem
	firmware-xiaomi-lisa-sensors
	firmware-xiaomi-lisa-vpu
	firmware-xiaomi-lisa-wpss
	linux-firmware-ath11k
	linux-firmware-qca
	linux-postmarketos-qcom-sc7280
	make-dynpart-mappings
	postmarketos-base
	soc-qcom
	soc-qcom-modem
	soc-qcom-qbootctl
	unl0kr-fbforcerefresh
"
makedepends="
	android-tools
	devicepkg-dev
	dtc
"
source="
	deviceinfo
	dtbo-overlay.dts
	initfs-hook-panel-cycle.sh
	kernel-cmdline.conf
	modules-initfs
	ucm-HiFi.conf
	ucm-lisa.conf
"

build() {
	devicepkg_build $startdir $pkgname

	# Empty overlay the Xiaomi ABL needs to find in dtbo, see dtbo-overlay.dts
	dtc -O dtb -o "$srcdir"/dtbo-overlay.dtbo -@ "$srcdir"/dtbo-overlay.dts
	mkdtboimg create "$srcdir"/dtbo.img --page_size=4096 \
		"$srcdir"/dtbo-overlay.dtbo
}

package() {
	devicepkg_package $startdir $pkgname

	install -Dm644 "$srcdir"/dtbo.img "$pkgdir"/boot/dtbo.img

	install -Dm644 "$srcdir"/initfs-hook-panel-cycle.sh \
		"$pkgdir"/usr/share/mkinitfs/hooks/50-xiaomi-lisa-panel-cycle.sh

	install -Dm644 "$srcdir"/ucm-lisa.conf \
		"$pkgdir"/usr/share/alsa/ucm2/Xiaomi/lisa/lisa.conf
	install -Dm644 "$srcdir"/ucm-HiFi.conf \
		"$pkgdir"/usr/share/alsa/ucm2/Xiaomi/lisa/HiFi.conf
	mkdir -p "$pkgdir"/usr/share/alsa/ucm2/conf.d/sm8250
	ln -s ../../Xiaomi/lisa/lisa.conf \
		"$pkgdir/usr/share/alsa/ucm2/conf.d/sm8250/Xiaomi 11 Lite 5G NE.conf"
}
