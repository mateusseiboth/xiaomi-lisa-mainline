maintainer="Luca Weiss <luca@lucaweiss.eu>"
_flavor="postmarketos-qcom-sc7280"
pkgname=linux-$_flavor
pkgver=7.2.9
pkgrel=5
pkgdesc="Mainline Kernel fork for SC7280/SM7325/QCM6490 devices"
arch="aarch64"
_carch="arm64"
url="https://github.com/sc7280-mainline/linux"
license="GPL-2.0-only"
options="!strip !check !tracedeps
	pmb:cross-native
	pmb:kconfigcheck-community
	pmb:kconfigcheck-uefi
	pmb:kconfigcheck-virt
	"
makedepends="
	bison
	clang
	elfutils-dev
	findutils
	flex
	installkernel
	linux-headers
	lld
	llvm
	openssl-dev
	pahole
	perl
	python3
	zstd
"

_repo="linux"
_config="config-$_flavor.$arch"
_tag="v$pkgver-sc7280"

# Source
source="
	https://github.com/sc7280-mainline/$_repo/archive/refs/tags/$_tag/$_repo-$_tag.tar.gz
	$_config
	0001-arm64-dts-qcom-sm7325-Add-Xiaomi-11-Lite-5G-NE.patch
	0002-arm64-dts-qcom-sm7325-xiaomi-lisa-add-msm-id-and-board-id.patch
	0003-drm-panel-Add-CSOT-VTDR6130-panel-driver.patch
	0004-arm64-dts-qcom-sm7325-xiaomi-lisa-enable-display.patch
	0005-arm64-dts-qcom-sm7325-xiaomi-lisa-enable-speaker-and-earpiece.patch
	0006-media-i2c-Add-S5K5E9-camera-sensor-driver.patch
	0007-arm64-dts-qcom-sm7325-xiaomi-lisa-enable-the-macro-camera.patch
	0008-arm64-dts-qcom-sm7325-xiaomi-lisa-enable-the-ultra-wide-camera.patch
	0009-power-supply-qcom_battmgr-stop-polling-unsupported-properties.patch
	0010-media-i2c-Add-Samsung-S5KGW3-image-sensor-driver.patch
	0011-arm64-dts-qcom-sm7325-xiaomi-lisa-enable-the-main-camera.patch
	0012-media-i2c-Add-Samsung-S5K3T2-image-sensor-driver.patch
	0013-arm64-dts-qcom-sm7325-xiaomi-lisa-enable-the-front-camera.patch
"
builddir="$srcdir/$_repo-$pkgver-sc7280"

prepare() {
	default_prepare
	cp "$srcdir/config-$_flavor.$arch" .config
}

build() {
	unset LDFLAGS
	make ARCH="$_carch" LLVM=1 \
		KBUILD_BUILD_VERSION="$((pkgrel + 1 ))-$_flavor"
}

package() {
	# ZBOOT EFI decompressor for EFI booting
	install -Dm644 "$builddir/arch/$_carch/boot/vmlinuz.efi" \
		"$pkgdir/boot/linux.efi"

	# Old GZIP'd kernel image for boot.img compatibility
	install -Dm644 "$builddir/arch/$_carch/boot/vmlinuz" \
		"$pkgdir/boot/vmlinuz"

	make modules_install dtbs_install \
		ARCH="$_carch" \
		LLVM=1 \
		INSTALL_PATH="$pkgdir"/boot/ \
		INSTALL_MOD_PATH="$pkgdir"/usr \
		INSTALL_MOD_STRIP=1 \
		INSTALL_DTBS_PATH="$pkgdir"/boot/dtbs
	rm "$pkgdir"/usr/lib/modules/*/build

	install -D "$builddir"/include/config/kernel.release \
		"$pkgdir"/usr/share/kernel/$_flavor/kernel.release
}

