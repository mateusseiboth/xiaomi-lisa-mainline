From: Mateus Seiboth <mateusseiboth12@gmail.com>
Subject: [PATCH] arm64: dts: qcom: sm7325-xiaomi-lisa: enable speaker and earpiece

Two TFA9873 amplifiers on PRIMARY_MI2S with the q6asm/q6afe (APR) stack,
like the Nothing Phone (1). I2C bus and reset GPIOs from the mainlining fork.
---
--- a/arch/arm64/boot/dts/qcom/sm7325-xiaomi-lisa.dts
+++ b/arch/arm64/boot/dts/qcom/sm7325-xiaomi-lisa.dts
@@ -13,6 +13,8 @@
 #include <dt-bindings/leds/common.h>
 #include <dt-bindings/pinctrl/qcom,pmic-gpio.h>
 #include <dt-bindings/regulator/qcom,rpmh-regulator.h>
+#include <dt-bindings/sound/qcom,q6afe.h>
+#include <dt-bindings/sound/qcom,q6asm.h>
 
 #include "sm7325.dtsi"
 #include "pm7325.dtsi"
@@ -1230,3 +1232,132 @@
 		bias-pull-down;
 	};
 };
+
+/*
+ * Speaker and earpiece: two TFA9873 amplifiers on PRIMARY_MI2S, same design
+ * as the Nothing Phone (1). Bus and reset GPIOs from the mainlining fork.
+ * Each amplifier needs its own name prefix (the codec widgets clash otherwise)
+ * and takes one I2S channel: left for the earpiece, right for the speaker.
+ */
+&i2c3 {
+	clock-frequency = <100000>;
+	status = "okay";
+
+	tfa9873_l: codec@34 { /* Earpiece */
+		compatible = "nxp,tfa9873",
+			     "nxp,tfa9872";
+		reg = <0x34>;
+		reset-gpio = <&tlmm 2 GPIO_ACTIVE_HIGH>;
+		sound-name-prefix = "Earpiece";
+		sound-channel = <0>;
+
+		#sound-dai-cells = <1>;
+	};
+
+	tfa9873_r: codec@35 { /* Speaker */
+		compatible = "nxp,tfa9873",
+			     "nxp,tfa9872";
+		reg = <0x35>;
+		reset-gpio = <&tlmm 6 GPIO_ACTIVE_HIGH>;
+		sound-name-prefix = "Speaker";
+		sound-channel = <1>;
+
+		#sound-dai-cells = <1>;
+	};
+};
+
+&lpass_audiocc {
+	compatible = "qcom,qcm6490-lpassaudiocc";
+	/delete-property/ power-domains;
+};
+
+&q6afedai {
+	dai@16 {
+		reg = <PRIMARY_MI2S_RX>;
+		qcom,sd-lines = <1>;
+	};
+};
+
+&q6asmdai {
+	dai@0 {
+		reg = <MSM_FRONTEND_DAI_MULTIMEDIA1>;
+	};
+};
+
+&sound {
+	compatible = "qcom,sm7325-sndcard",
+		     "qcom,sm8250-sndcard";
+
+	model = "Xiaomi 11 Lite 5G NE";
+
+	pinctrl-0 = <&pri_mi2s_bck_active &pri_mi2s_din_active
+		     &pri_mi2s_dout_active &pri_mi2s_ws_active>;
+	pinctrl-1 = <&pri_mi2s_sleep>;
+	pinctrl-names = "default", "sleep";
+
+	mm1-dai-link {
+		link-name = "MultiMedia1";
+
+		cpu {
+			sound-dai = <&q6asmdai MSM_FRONTEND_DAI_MULTIMEDIA1>;
+		};
+	};
+
+	i2s-dai-link {
+		link-name = "I2S Playback";
+
+		cpu {
+			sound-dai = <&q6afedai PRIMARY_MI2S_RX>;
+		};
+
+		platform {
+			sound-dai = <&q6routing>;
+		};
+
+		codec {
+			sound-dai = <&tfa9873_l 0>, <&tfa9873_r 0>;
+		};
+	};
+};
+
+&tlmm {
+	pri_mi2s_bck_active: pri-mi2s-bck-active-state {
+		pins = "gpio97";
+		function = "mi2s0_sck";
+		drive-strength = <8>;
+		bias-disable;
+		output-high;
+	};
+
+	pri_mi2s_din_active: pri-mi2s-din-active-state {
+		pins = "gpio98";
+		function = "mi2s0_data0";
+		drive-strength = <8>;
+		bias-disable;
+		output-high;
+	};
+
+	pri_mi2s_dout_active: pri-mi2s-dout-active-state {
+		pins = "gpio99";
+		function = "mi2s0_data1";
+		drive-strength = <8>;
+		bias-disable;
+		output-high;
+	};
+
+	pri_mi2s_ws_active: pri-mi2s-ws-active-state {
+		pins = "gpio100";
+		function = "mi2s0_ws";
+		drive-strength = <8>;
+		bias-disable;
+		output-high;
+	};
+
+	pri_mi2s_sleep: pri-mi2s-sleep-state {
+		pins = "gpio97", "gpio98", "gpio99", "gpio100";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-pull-down;
+		input-enable;
+	};
+};
